<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>io.quarkiverse.fleettest</groupId>
        <artifactId>quarkus-fleet-test-parent</artifactId>
        <version>0.1.1</version>
    </parent>
    <artifactId>quarkus-fleet-test-samples-parent</artifactId>
    <name>Quarkus Fleet Test - Samples - Parent</name>
    <packaging>pom</packaging>
    <modules>
        <module>scheduled-job</module>
        <module>form-auth</module>
        <module>oidc-login</module>
        <module>rolling-restart</module>
        <module>zombie-leader</module>
        <module>crash-redelivery</module>
        <module>scale-out</module>
        <module>idempotency</module>
        <module>local-cache</module>
        <module>rate-limit</module>
        <module>websocket-broadcast</module>
        <module>outbox-double-send</module>
        <module>pool-exhaustion</module>
        <module>upload-local-disk</module>
        <module>job-killed-midway</module>
        <module>lost-update</module>
        <module>distributed-deadlock</module>
        <module>write-skew</module>
        <module>event-ordering</module>
    </modules>
    <dependencies>
        <!-- the extension is a test-only dependency, as it would be in a real application -->
        <dependency>
            <groupId>io.quarkiverse.fleettest</groupId>
            <artifactId>quarkus-fleet-test</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-junit</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.rest-assured</groupId>
            <artifactId>rest-assured</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <version>${assertj.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.awaitility</groupId>
            <artifactId>awaitility</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
    <build>
        <plugins>
            <!-- every sample is a Quarkus application with a multi-instance bug, and the fleet test that finds it -->
            <plugin>
                <groupId>io.quarkus</groupId>
                <artifactId>quarkus-maven-plugin</artifactId>
                <extensions>true</extensions>
                <executions>
                    <execution>
                        <goals>
                            <goal>build</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <artifactId>maven-failsafe-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
